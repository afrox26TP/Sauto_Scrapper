# Required in production: change to a long random secret.
AUTH_SECRET=change-me-to-a-long-random-secret

# Comma-separated allowed origins for browser access to FastAPI.
# Use * only if you intentionally want public CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Optional: API keys for write endpoints (POST/PUT/PATCH/DELETE).
# SAUTO_API_KEYS=key_a,key_b

# Optional billing rates.
# BILLING_RUN_BASE_CZK=5.0
# BILLING_ITEM_CZK=0.02
# BILLING_API_CALL_CZK=0.05
# BILLING_PROXY_RUN_CZK=0.0
